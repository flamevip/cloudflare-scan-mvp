WORKER_NAME=cloudflare-scan-mvp-staging
ENVIRONMENT=staging
TOKEN_SCOPE_ENFORCEMENT=report
CALLBACK_BASE_URL=https://replace-staging-worker.example.workers.dev
AGENT_SCAN_MODE=mock
AGENT_MAX_CANDIDATES=100
TENCENT_EKS_CI_REGION=ap-chengdu
TENCENT_EKS_CI_VPC_ID=vpc-replace
TENCENT_EKS_CI_SUBNET_ID=subnet-replace
TENCENT_EKS_CI_SECURITY_GROUP_IDS=sg-replace
TENCENT_EKS_CI_IMAGE=replace.tencentcloudcr.com/scan-agent/scan-agent@sha256:replace
TENCENT_EKS_CI_ALLOWED_REGISTRY_HOST=replace.tencentcloudcr.com
TENCENT_EKS_CI_AUTO_CREATE_EIP=true
TENCENT_EKS_CI_EIP_BANDWIDTH_MBPS=5
TENCENT_EKS_CI_EIP_ISP=BGP
TENCENT_EKS_CI_DRY_RUN=true
TENCENT_TCR_SERVER=replace.tencentcloudcr.com
D1_DATABASE_NAME=scan_mvp_metadata_staging
D1_DATABASE_ID=replace
R2_BUCKET_NAME=scan-artifacts-staging
AI_SEARCH_INSTANCE_NAME=scan-artifacts-search-staging
SCAN_QUEUE_NAME=scan-dispatch-staging
DEADLETTER_QUEUE_NAME=scan-deadletter-staging

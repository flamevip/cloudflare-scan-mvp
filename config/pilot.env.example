WORKER_NAME=cloudflare-scan-mvp-pilot
ENVIRONMENT=pilot
TOKEN_SCOPE_ENFORCEMENT=enforce
CALLBACK_BASE_URL=https://replace-pilot-worker.example.workers.dev
AGENT_SCAN_MODE=real_toolchain
AGENT_MAX_CANDIDATES=100
TENCENT_EKS_CI_REGION=ap-shanghai
TENCENT_EKS_CI_VPC_ID=vpc-replace
TENCENT_EKS_CI_SUBNET_ID=subnet-replace
TENCENT_EKS_CI_SECURITY_GROUP_IDS=sg-replace
TENCENT_EKS_CI_IMAGE=replace.tencentcloudcr.com/scan-agent/scan-agent@sha256:replace
TENCENT_EKS_CI_ALLOWED_REGISTRY_HOST=replace.tencentcloudcr.com
TENCENT_EKS_CI_DRY_RUN=true
TENCENT_TCR_SERVER=replace.tencentcloudcr.com
D1_DATABASE_NAME=scan_mvp_metadata_pilot
D1_DATABASE_ID=replace
R2_BUCKET_NAME=scan-artifacts-pilot
AI_SEARCH_INSTANCE_NAME=scan-artifacts-search-pilot
SCAN_QUEUE_NAME=scan-dispatch-pilot
DEADLETTER_QUEUE_NAME=scan-deadletter-pilot
